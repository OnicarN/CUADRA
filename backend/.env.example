# Copia este archivo como .env y rellena lo que necesites.
# Sin rellenar nada, la app arranca en local con una base de datos PGlite en backend/.data/

PORT=3000
URL_PUBLICA=http://localhost:3000

# Base de datos. Vacío = PGlite local (sin instalar nada). En producción: la URL de Neon.
DATABASE_URL=

# Sesiones. En producción pon una cadena larga y aleatoria.
JWT_SECRETO=cambia-esto-en-produccion

# Lectura automática con IA (Dani)
ANTHROPIC_API_KEY=
MODELO_IA=claude-opus-5-5

# Envío de emails (verificación, avisos, gestoría). Vacío = se imprimen en la consola.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
EMAIL_REMITENTE=Cuadra <hola@cuadra.app>

# Correo propio de cada usuario (Dani): alias@CORREO_DOMINIO
CORREO_DOMINIO=facturas.cuadra.app
CORREO_WEBHOOK_SECRETO=

# Google: inicio de sesión (Ana) y Google Calendar (Dani)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pagos (Ana). Claves de prueba de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
