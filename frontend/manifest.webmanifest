{
  "id": "/app/panel",
  "name": "Cuadra",
  "short_name": "Cuadra",
  "description": "Tus facturas y tickets, cuadrados.",
  "lang": "es",
  "start_url": "/app/panel",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F6F6F4",
  "theme_color": "#F6F6F4",
  "icons": [
    { "src": "/img/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/img/icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icono-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Subir factura", "short_name": "Subir", "url": "/app/subir", "icons": [{ "src": "/img/icono-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/app/subir?compartido=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "archivos", "accept": ["application/pdf", "image/*", ".pdf", ".jpg", ".jpeg", ".png", ".heic", ".heif"] }]
    }
  }
}
